{
  "version": 10,
  "configurePresets": [
    { "name": "gcc", "generator": "Ninja", "binaryDir": "${sourceDir}/build-gcc",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++", "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "clang", "generator": "Ninja", "binaryDir": "${sourceDir}/build-clang",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++", "CMAKE_BUILD_TYPE": "Debug" } }
  ],
  "buildPresets": [
    { "name": "gcc", "configurePreset": "gcc" },
    { "name": "clang", "configurePreset": "clang" }
  ],
  "workflowPresets": [
    { "name": "gcc", "steps": [ { "type": "configure", "name": "gcc" }, { "type": "build", "name": "gcc" } ] },
    { "name": "clang", "steps": [ { "type": "configure", "name": "clang" }, { "type": "build", "name": "clang" } ] }
  ]
}
